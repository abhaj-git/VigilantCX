<section class="product page-width" data-product>
  <div class="product-gallery" data-gallery aria-label="{{ product.title | escape }} image gallery">
    <div class="product-gallery-viewport">
      {% for image in product.images %}
        <figure
          class="product-media"
          data-gallery-slide
          data-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {{ image
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: image.alt
          }}
        </figure>
      {% else %}
        <div class="product-media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {% endfor %}

      {% if product.images.size > 1 %}
        <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Previous image">
          <span aria-hidden="true">←</span>
        </button>
        <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Next image">
          <span aria-hidden="true">→</span>
        </button>
        <p class="gallery-counter" aria-live="polite">
          <span data-gallery-current>1</span> / {{ product.images.size }}
        </p>
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product-gallery-thumbnails" role="tablist" aria-label="Choose product image">
        {% for image in product.images %}
          <button
            class="gallery-thumbnail{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Show image {{ forloop.index }} of {{ product.images.size }}"
            data-gallery-thumb
            data-index="{{ forloop.index0 }}"
          >
            {{ image
              | image_url: width: 180
              | image_tag: width: 90, height: 90, loading: 'lazy', alt: image.alt
            }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-details">
    <p class="eyebrow">{{ product.vendor | default: 'SVANK' }}</p>
    <h1>{{ product.title }}</h1>
    <p class="product-price">{{ product.selected_or_first_available_variant.price | money }}</p>
    <div class="product-description">{{ product.description }}</div>

    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}
        <label for="Variant-{{ section.id }}">Style</label>
        <select id="Variant-{{ section.id }}" name="id">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      <label for="Quantity-{{ section.id }}">Quantity</label>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      <button class="button button-wide" type="submit" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to bag{% else %}Sold out{% endif %}
      </button>
      {{ form | payment_button }}
    {% endform %}

    <details open>
      <summary>Details</summary>
      <p>Designed for comfortable, everyday wear. Product specifications can be updated in Shopify.</p>
    </details>
    <details>
      <summary>Shipping & returns</summary>
      <p>Ships from the United States. Add your finalized US and Canada delivery and return terms here.</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
