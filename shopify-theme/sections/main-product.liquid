<section class="product page-width" data-product>
  <div class="product-gallery">
    {% for media in product.media %}
      <div class="product-media">
        {% if media.media_type == 'image' %}
          {{ media
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: media.alt
          }}
        {% endif %}
      </div>
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {% endfor %}
  </div>

  <div class="product-details">
    <p class="eyebrow">{{ product.vendor | default: 'SVANK' }}</p>
    <h1>{{ product.title }}</h1>
    <p class="product-price">{{ product.selected_or_first_available_variant.price | money }}</p>
    <div class="product-description">{{ product.description }}</div>

    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}
        <label for="Variant-{{ section.id }}">Style</label>
        <select id="Variant-{{ section.id }}" name="id">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      <label for="Quantity-{{ section.id }}">Quantity</label>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      <button class="button button-wide" type="submit" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to bag{% else %}Sold out{% endif %}
      </button>
      {{ form | payment_button }}
    {% endform %}

    <details open>
      <summary>Details</summary>
      <p>Designed for comfortable, everyday wear. Product specifications can be updated in Shopify.</p>
    </details>
    <details>
      <summary>Shipping & returns</summary>
      <p>Ships from the United States. Add your finalized US and Canada delivery and return terms here.</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
