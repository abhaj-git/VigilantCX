<section class="story section page-width">
  <div class="story-card">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="story-copy">{{ section.settings.text }}</div>
    {% if section.settings.link_label != blank %}
      <a class="text-link" href="{{ section.settings.link | default: '/pages/about' }}">
        {{ section.settings.link_label | escape }}
      </a>
    {% endif %}
  </div>
  <div class="story-points">
    {% for block in section.blocks %}
      <div class="story-point" {{ block.shopify_attributes }}>
        <span>0{{ forloop.index }}</span>
        <h3>{{ block.settings.heading | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Why SVANK",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Good shade. Great outlook.",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>We make expressive sunglasses for people who would rather be planning their next escape.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "Our story",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "heading", "default": "Easy comfort", "label": "Heading" },
        { "type": "text", "id": "text", "default": "Lightweight frames for all-day plans.", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "point", "settings": { "heading": "Easy comfort", "text": "Lightweight frames for all-day plans." } },
        { "type": "point", "settings": { "heading": "Everyday style", "text": "Clean silhouettes with just enough edge." } },
        { "type": "point", "settings": { "heading": "Ready to roam", "text": "Made for bright days near and far." } }
      ]
    }
  ]
}
{% endschema %}
