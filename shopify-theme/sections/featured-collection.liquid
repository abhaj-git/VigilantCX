{% assign featured_collection = section.settings.collection %}
{% if featured_collection == blank %}
  {% assign featured_collection = collections['all'] %}
{% endif %}

<section class="section page-width">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {% if featured_collection != blank %}
      <a class="text-link" href="{{ featured_collection.url }}">View all</a>
    {% endif %}
  </div>

  <div class="product-grid">
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <article class="product-card">
          <div class="product-card-media">
            {% if i == 1 %}
              <img src="{{ 'svank-clean-blue.png' | asset_url }}" width="900" height="900" loading="lazy" alt="Blue mirrored sunglasses">
            {% elsif i == 2 %}
              <img src="{{ 'svank-clean-round.png' | asset_url }}" width="900" height="900" loading="lazy" alt="Translucent blue round sunglasses">
            {% else %}
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}
            {% endif %}
          </div>
          <div class="product-card-info">
            <h3>{% if i == 1 %}The Coast{% elsif i == 2 %}The Weekend{% else %}Your product{% endif %}</h3>
            <span>{% if i < 3 %}$49.00{% else %}$0.00{% endif %}</span>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "New light",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Meet the first drop",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (defaults to All products)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
